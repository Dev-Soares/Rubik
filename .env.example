# `.env` da RAIZ — lido pelo docker compose.
#
# Você não precisa criar este arquivo: `scripts/ports.mjs` roda antes de todo
# comando de dev e o escreve sozinho, com as portas livres que encontrou. Copie
# para `.env` apenas se quiser fixar algum valor à mão.
#
# Porta do HOST de cada serviço. A porta INTERNA (o que conversa na rede do
# compose) é fixa e não sai daqui.
POSTGRES_PORT=5432
SERVER_PORT=3000
CLIENT_PORT=3001
STUDIO_PORT=4983

# Perfil `prod` (smoke test local das imagens de produção).
CLIENT_PROD_PORT=8080

# Segredos do perfil dev. Vazio usa o default do compose, que serve para rodar
# local e não serve para mais nada.
BETTER_AUTH_SECRET=
INTEGRATION_API_KEY=
