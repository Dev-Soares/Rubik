# Dev — hot reload via bind mount. Build a partir da RAIZ do repositório.
#   docker compose up

FROM node:22-alpine

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable

WORKDIR /app

# Só os manifests: a camada de deps só invalida quando package.json muda.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY server/package.json ./server/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
	pnpm install --filter server... --frozen-lockfile

# O código vem por bind mount no compose, não por COPY.
WORKDIR /app/server

EXPOSE 3000

# Bind mount no Windows/macOS não propaga eventos nativos de fs.
# TSC_WATCHFILE força o tsc --watch a usar polling (ver tsconfig.json > watchOptions).
ENV TSC_WATCHFILE=PriorityPollingInterval
ENV CHOKIDAR_USEPOLLING=true

# Migration e seed antes da API, como no Dockerfile de produção: `pnpm dev` é o
# único comando do fluxo, e um clone novo sobe com o schema aplicado e o admin
# inicial criado. O compose já garante que o Postgres está saudável aqui.
#
# `db:migrate` não é tolerante a falha: sem schema a API não tem o que servir, e
# o erro precisa aparecer em vez de virar 500 na primeira requisição. O seed é,
# porque ele é idempotente e um segundo clone com o admin já criado não é erro.
CMD ["sh", "-c", "pnpm db:migrate && { pnpm db:seed || true; } && pnpm start:dev"]
