# Template, não conf final: o entrypoint da imagem nginx roda `envsubst` sobre
# `/etc/nginx/templates/*.template` no boot e escreve o resultado em
# `conf.d/`. É o que permite a porta vir do ambiente.
#
# `NGINX_ENVSUBST_FILTER=PORT` no Dockerfile restringe a substituição a essa
# variável. Sem o filtro, `envsubst` também comeria `$uri` e `$http_upgrade` —
# variáveis do próprio nginx, que não existem no ambiente e virariam string
# vazia: `try_files $uri` sem argumento, e o SPA para de resolver rota.
server {
	# Railway, Cloud Run e afins injetam `PORT` e roteiam só para ela. O default
	# mantém `docker run -p 8080:80` funcionando fora desses ambientes.
	listen ${PORT};
	server_name _;
	root /usr/share/nginx/html;
	index index.html;

	gzip on;
	gzip_types text/css application/javascript application/json image/svg+xml;
	gzip_min_length 1024;

	# Assets com hash no nome — cache agressivo, o hash invalida sozinho.
	# Sem `expires`: ele emitiria um segundo Cache-Control e a resposta sairia
	# com o header duplicado (comportamento indefinido em proxy/CDN).
	location /assets/ {
		add_header Cache-Control "public, max-age=31536000, immutable";
		try_files $uri =404;
	}

	# HTML sempre revalida: é ele que aponta para os assets com hash novo.
	# Precisa de location próprio porque o `add_header` do bloco `/` NÃO se
	# aplica ao fallback interno do try_files — sem isto, /dashboard voltaria
	# sem Cache-Control e o browser usaria heurística própria (versão presa).
	location = /index.html {
		add_header Cache-Control "no-cache, must-revalidate";
		etag on;
	}

	# SPA: qualquer rota desconhecida cai no index.html (client-side routing).
	location / {
		try_files $uri $uri/ /index.html;
		add_header Cache-Control "no-cache, must-revalidate";
		etag on;
	}
}
