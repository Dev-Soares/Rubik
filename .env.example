# `.env` da RAIZ — lido pelo docker compose.
#
# Copie para `.env` (`pnpm setup` faz isso). Os valores abaixo repetem o default
# do compose, então um `.env` ausente dá o mesmo resultado.
#
# Porta do HOST de cada serviço — FIXA. A porta INTERNA (o que conversa na rede
# do compose) é a mesma e também não muda.
#
# Porta ocupada por outro projeto da máquina → o compose falha com `port is
# already allocated`. Pare o outro projeto, ou mude o valor aqui à mão.
POSTGRES_PORT=5432
SERVER_PORT=3000
CLIENT_PORT=3001
STUDIO_PORT=4983

# Perfil `prod` (smoke test local das imagens de produção).
CLIENT_PROD_PORT=8080

# Segredos do perfil dev. Vazio usa o default do compose, que serve para rodar
# local e não serve para mais nada.
BETTER_AUTH_SECRET=
INTEGRATION_API_KEY=
