NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/appdb

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-no-minimo-32-chars

CORS_ORIGIN=http://localhost:3001

LOG_LEVEL=info

SWAGGER_USER=admin
SWAGGER_PASSWORD=admin

# Admin inicial criado por `pnpm db:seed` (bloqueado em produção).
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin12345

# Storage S3-compatível das fotos de chamado (AWS S3, Cloudflare R2, MinIO).
# S3_ENDPOINT vazio = AWS. MinIO/R2 exigem S3_FORCE_PATH_STYLE=true.
S3_REGION=us-east-1
S3_BUCKET=app-tickets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=900
# Host que o navegador usa para baixar a foto (vazio = usa S3_ENDPOINT).
S3_PUBLIC_ENDPOINT=http://localhost:9000

# Chave que a integracao de atendimento usa em `x-api-key` para marcar chamado
# como resolvido. Minimo 32 caracteres; gere uma aleatoria por ambiente.
INTEGRATION_API_KEY=troque-por-uma-chave-aleatoria-de-32-chars

# Sistema externo que recebe cada chamado aberto. Vazio desliga o envio.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_API_KEY=
TICKET_WEBHOOK_PROJECT_ID=
TICKET_WEBHOOK_TIMEOUT_MS=10000
