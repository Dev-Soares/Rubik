NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rubikdb

# A origem do CLIENT, não a da API: em dev o navegador chega à API pelo proxy do
# Vite, então é essa a origem que ele usa — a porta do server ele nunca vê.
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-de-no-minimo-32-chars

CORS_ORIGIN=http://localhost:3001

LOG_LEVEL=info

# O admin inicial (`desenvolvedor@letsup.team` / `123mudar`) é fixo no código,
# em `server/src/db/seed.ts`. Troque a senha no primeiro login.

# Chave que a integracao de atendimento usa em `x-api-key` para marcar chamado
# como resolvido. Minimo 32 caracteres; gere uma aleatoria por ambiente.
INTEGRATION_API_KEY=troque-por-uma-chave-aleatoria-de-32-chars

# Sistema externo que recebe cada chamado aberto. Vazio desliga o envio.
TICKET_WEBHOOK_URL=
TICKET_WEBHOOK_API_KEY=
TICKET_WEBHOOK_PROJECT_ID=
TICKET_WEBHOOK_TIMEOUT_MS=10000
# Dias que um chamado resolvido sobrevive antes da limpeza diaria apaga-lo.
TICKET_RETENTION_DAYS=30

# Storage das fotos de chamado (AWS S3 ou Cloudflare R2).
# Vazio = upload de foto desligado; o resto da aplicação roda normalmente.
# S3_ENDPOINT fica vazio na AWS; R2 exige o endpoint da conta + path style.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL=900
